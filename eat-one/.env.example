PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Empty uses SQLite locally. Use a managed PostgreSQL URL for production.
DATABASE_URL=
DATABASE_SSL=true
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SITE_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
# Set ADMIN_EMAIL and ADMIN_PASSWORD, then run npm run admin. No public admin registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
